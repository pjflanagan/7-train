# Copy to .env.local and fill in. Every block below is optional: the planner
# works signed out, offline, with none of these set — that is the local-first
# design, not a degraded mode. Each block switches on one feature, and a feature
# whose variables are missing hides itself rather than offering a button that
# can only fail.

# --- Google sign in, calendar sync and Sheets export -------------------------
# Google Cloud console -> APIs & services -> Credentials -> OAuth client ID.
# Authorised redirect URI: <your origin>/api/auth/callback/google
# See _todo/done/2026-08-12-manual-google-setup.md.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Any random string: `openssl rand -base64 32`. Signs the session cookie, and
# encrypts the Strava token cookie too — rotating it signs everyone out and
# drops every Strava connection.
AUTH_SECRET=

# --- Strava ------------------------------------------------------------------
# strava.com/settings/api. The "Authorization Callback Domain" there is a bare
# domain — no scheme, no path — and there is one per application, so local
# development needs its own app registered against `localhost`.
# See _todo/-MANUAL-strava-setup.md.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Database ----------------------------------------------------------------
# Neon Postgres connection string, pooled. Stores settings, third-party account
# ids and "My activities" — never events, which live in Google Calendar.
# Run `npm run db:migrate` once after setting this.
# See _todo/-MANUAL-database-setup.md.
DATABASE_URL=
