# Copy to .env.local and fill in. See docs/google-setup.md for where each value
# comes from. Without these the app still runs — sign in is simply hidden.

# openssl rand -base64 32
AUTH_SECRET=

# Google Cloud console > APIs & services > Credentials > OAuth 2.0 client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only needed if NextAuth guesses the wrong origin (behind a proxy, or a
# preview URL that has to match the registered redirect URI).
# AUTH_URL=http://localhost:3000
